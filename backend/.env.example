# Copie este arquivo para ".env" e preencha. O ".env" NUNCA deve ser enviado ao git.

# Token do bot, entregue pelo @BotFather no Telegram (trate como uma senha!)
TELEGRAM_TOKEN=

# Opcional: ID do seu chat. Se vazio, o bot pareia com o primeiro a enviar /start.
# TELEGRAM_CHAT_ID=

# Opcional: fixa o mês de referência (AAAA-MM). Se vazio, usa o mês atual.
# MES_REFERENCIA=2026-10
